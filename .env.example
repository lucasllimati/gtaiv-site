# Copie para .env e ajuste. NUNCA versione o .env.

# ---------- Banco ----------
# Local: arquivo SQLite (padrão). Produção: libSQL/Turso (persistente).
DATABASE_URL=file:.local/dev.db
# DATABASE_URL=libsql://seu-banco.turso.io
DATABASE_AUTH_TOKEN=

# ---------- API ----------
PORT=8787
PUBLIC_API_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
# Serve o build do frontend pela própria API (site + painel na mesma origem).
# WEB_DIST_DIR=apps/web/dist

# ---------- Mídia ----------
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.local/media
MEDIA_MAX_MB=25
# MEDIA_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.seudominio.com

# ---------- IA (opcional) ----------
# Sem chave, os rascunhos e pacotes sociais usam um modelo de texto determinístico.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=50

# ---------- Republicação do site estático (opcional) ----------
# Token fine-grained com permissão "Contents: read & write" apenas neste repositório.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=lucasllimati/gtaiv-site

# ---------- Privacidade ----------
CLICK_RETENTION_DAYS=180

# ---------- Frontend (build) ----------
# VITE_DATA_MODE=snapshot | api
# VITE_API_URL=
# VITE_BASE=/
# VITE_SITE_URL=https://seudominio.com
# VITE_ADMIN_URL=https://api.seudominio.com/admin
